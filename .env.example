# Copy to .env (gitignored) to change a default. Nothing here is required.

# Hugging Face token, only to download pyannote Community-1 (gated) the first time. Accept its
# terms at https://hf.co/pyannote/speaker-diarization-community-1 first.
HF_TOKEN=

# Your system: the Khmer segmentation model + Community-1's embedding, PLDA and VBx.
# DIAR_SEGMENTATION=weights/segmentation_khmer.ckpt
# auto | cuda | cuda:0 | cpu
# DIAR_DEVICE=auto

# Reference: DiariZen, run in its own environment (scripts/setup_diarizen.sh).
# DIARIZEN_PYTHON=.venv-diarizen/bin/python
# DIARIZEN_MODEL=BUT-FIT/diarizen-wavlm-large-s80-md-v2
# auto (the last GPU, so both systems run at once on two GPUs) | cuda:1 | cpu
# DIARIZEN_DEVICE=auto

# Second opinion for the pseudo-labels: Nemotron-3-Diarization (scripts/setup_nemotron.sh).
# NEMOTRON_PYTHON=.venv-nemo/bin/python
# NEMOTRON_MODEL=nvidia/Nemotron-3-Diarization
# auto (the first GPU) | cuda:0 | cpu
# NEMOTRON_DEVICE=auto

# Dataset export and upload. Pushing needs a Hugging Face token with write access
# (hf auth login, or HF_TOKEN above).
# BENCH_EXPORT_DIR=exports
# HF_DATASET_REPO=your-user/khmer-diarization-eval

# Where recordings and results are kept
# BENCH_DATA_DIR=data
# Audio files in this folder are offered in the import form
# BENCH_INBOX_DIR=inbox
# BENCH_HOST=127.0.0.1
